# Copy this file to .env and fill in. NEVER commit .env - it is gitignored.

# Reddit "script" app: https://www.reddit.com/prefs/apps  -> create app -> type: script
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=pain-radar/0.1 by u/YOUR_REDDIT_USERNAME

# Stage 3 - AI synthesis. Get a free key (no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional fallback if Gemini fails/rate-limits - https://console.groq.com/keys
# Not required. Gemini alone retries hard (~1min of backoff) before giving up.
GROQ_API_KEY=

# Optional overrides - only set these if you want to change the model.
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_MODEL=llama-3.3-70b-versatile
